<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
    PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
    "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.ec.repository.DiscountCodeRepository">

    <select id="findByDiscountCode" resultType="com.example.ec.repository.entity.DiscountCodeEntity">
        SELECT
            discount_code AS discountCode,
            discount_rate AS discountRate
        FROM discount_codes
        WHERE discount_code = #{discountCode}
    </select>
</mapper>